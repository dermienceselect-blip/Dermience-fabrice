---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projetsTries } from '../lib';
import site from '../data/site.json';

// Accueil épuré : une galerie des projets. Ceux cochés « À la une » passent en premier.
const tous = await projetsTries();
const projets = [...tous.filter((p) => p.data.a_la_une), ...tous.filter((p) => !p.data.a_la_une)];
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base>
  <section class="conteneur intro">
    <h1 class="intro-titre">
      <span class="ligne-mask"><span>{site.nom}</span></span>
    </h1>
    <p class="intro-texte"><span class="ligne-mask"><span>{site.metier}. {site.accroche}</span></span></p>
  </section>

  <section class="conteneur galerie" aria-label="Projets">
    {projets.map((p, i) => (
      <a href={`/projets/${p.id}/`} class="item reveal" style={`transition-delay:${(i % 3) * 0.08}s`}>
        <div class="item-img">
          <Image src={p.data.couverture} alt={p.data.titre} widths={[500, 800, 1200]}
                 sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw" format="webp" quality={80}
                 loading={i < 3 ? 'eager' : 'lazy'} />
          <span class="item-voile" aria-hidden="true">
            <span class="item-cat">{p.data.categorie}</span>
            <span class="item-titre">{p.data.titre}</span>
          </span>
        </div>
        <span class="item-legende">
          <span>{p.data.titre}</span>
          <span class="item-legende-cat">{p.data.categorie}</span>
        </span>
      </a>
    ))}
  </section>

  <section class="conteneur bas">
    <a href="/travaux/" class="bouton">Voir tous les travaux →</a>
  </section>
</Base>

<style>
  .intro { padding-top: calc(var(--header) + clamp(48px, 9vw, 140px)); padding-bottom: clamp(40px, 6vw, 88px); }
  .intro-titre {
    margin: 0; font-stretch: 125%; font-weight: 800; text-transform: uppercase;
    font-size: clamp(2.2rem, 7vw, 6.5rem); line-height: 0.95; letter-spacing: -0.01em; text-wrap: balance;
  }
  .intro-texte { margin: 1.4rem 0 0; font-weight: 300; font-size: clamp(1.05rem, 1.6vw, 1.35rem); color: var(--texte-2); max-width: 46ch; }
  .ligne-mask { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .ligne-mask > span { display: block; animation: monte 1.1s var(--ease) both; }
  .intro-texte .ligne-mask > span { animation-delay: 0.15s; }
  @keyframes monte { from { transform: translateY(105%); } }

  /* Galerie en colonnes : chaque photo garde son format (portrait ou paysage) */
  .galerie { columns: 3; column-gap: clamp(16px, 2.4vw, 36px); }
  .item { display: block; break-inside: avoid; margin-bottom: clamp(28px, 3.6vw, 56px); }
  .item-img { position: relative; overflow: hidden; background: var(--fond-2); }
  .item-img img { width: 100%; transition: transform 1.2s var(--ease); }
  .item-voile {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.4rem;
    padding: clamp(16px, 2vw, 28px); color: #fff;
    background: linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0.15));
    opacity: 0; transition: opacity 0.6s var(--ease);
  }
  .item-cat { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; transform: translateY(12px); transition: transform 0.6s var(--ease); }
  .item-titre { font-stretch: 125%; font-weight: 800; text-transform: uppercase; font-size: clamp(1.2rem, 2vw, 1.7rem); line-height: 1; transform: translateY(16px); transition: transform 0.6s var(--ease) 0.05s; }
  .item:hover .item-voile, .item:focus-visible .item-voile { opacity: 1; }
  .item:hover .item-cat, .item:hover .item-titre, .item:focus-visible .item-cat, .item:focus-visible .item-titre { transform: none; }
  .item:hover .item-img img { transform: scale(1.04); }
  .item-legende { display: flex; justify-content: space-between; gap: 12px; padding-top: 0.8rem; font-size: 0.82rem; font-weight: 500; }
  .item-legende-cat { color: var(--gris); font-weight: 400; }

  .bas { display: flex; justify-content: center; padding-top: clamp(16px, 3vw, 40px); }

  @media (max-width: 1100px) { .galerie { columns: 2; } }
  @media (max-width: 640px) {
    .galerie { columns: 1; }
    .item-voile { display: none; }
  }
  @media (hover: none) { .item-voile { display: none; } }
</style>
