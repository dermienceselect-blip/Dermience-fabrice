---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import categories from '../data/categories.json';
const paragraphes = site.bio.split(/\n\s*\n/);
---
<Base titre="À propos" description={`${site.nom}, photographe : ${site.accroche}`}>
  <section class="conteneur apropos">
    <div class="portrait reveal">
      <img src="/images/fabrice.jpg" alt={`Portrait de ${site.nom}`} width="1600" height="2000" />
    </div>
    <div class="texte">
      <p class="surtitre reveal">À propos</p>
      <h1 class="titre-l reveal">{site.nom}</h1>
      {paragraphes.map((p) => <p class="bio reveal">{p}</p>)}
      <ul class="domaines reveal" aria-label="Domaines">
        {categories.map((c) => <li>{c}</li>)}
      </ul>
      <a href="/contact/" class="bouton plein reveal">Travailler ensemble →</a>
    </div>
  </section>
</Base>

<style>
  .apropos { padding-top: calc(var(--header) + clamp(40px, 7vw, 110px)); display: grid; grid-template-columns: 5fr 6fr; gap: clamp(32px, 6vw, 110px); align-items: start; }
  .portrait { position: sticky; top: calc(var(--header) + 24px); overflow: hidden; aspect-ratio: 4 / 5; background: var(--fond-2); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter 1s var(--ease); }
  .portrait:hover img { filter: grayscale(0); }
  .texte .titre-l { margin: 0.6rem 0 2.5rem; }
  .bio { font-size: clamp(1.1rem, 1.6vw, 1.35rem); font-weight: 300; line-height: 1.65; color: var(--texte-2); max-width: 40ch; margin: 0 0 1.4rem; }
  .bio:first-of-type { font-weight: 400; color: var(--texte); }
  .domaines { list-style: none; padding: 0; margin: 2.5rem 0 3rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; border-top: 1px solid var(--ligne); padding-top: 1.5rem; }
  .domaines li { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gris); }
  @media (max-width: 860px) {
    .apropos { grid-template-columns: 1fr; }
    .portrait { position: relative; top: 0; }
  }
</style>
