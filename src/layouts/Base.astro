---
import '../styles/global.css';
import site from '../data/site.json';

interface Props { titre?: string; description?: string; transparent?: boolean; sansFooter?: boolean }
const { titre, description = `${site.nom}, ${site.metier.toLowerCase()} en Belgique. ${site.accroche}`, transparent = false, sansFooter = false } = Astro.props;
const titreComplet = titre ? `${titre} | ${site.nom}` : `${site.nom} | ${site.metier}`;
const chemin = Astro.url.pathname;
const actif = (p: string) => (p === '/' ? chemin === '/' : chemin.startsWith(p)) ? 'actif' : '';
const liens = [
  { href: '/travaux/', label: 'Travaux' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/contact/', label: 'Contact' },
];
const whatsapp = `https://wa.me/${site.telephone.replace(/\D/g, '')}`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#fbfaf8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class:list={['entete', { transparent }]}>
      <a href="/" class="logo" aria-label="Accueil">
        <span class="logo-nom">Fabrice Dermience</span>
        <span class="logo-metier">Photographe</span>
      </a>
      <nav class="nav" aria-label="Menu principal">
        {liens.map((l) => <a href={l.href} class={actif(l.href)}>{l.label}</a>)}
      </nav>
      <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu-mobile">
        <span></span><span></span>
      </button>
    </header>

    <div id="menu-mobile" class="menu-mobile" hidden>
      <nav aria-label="Menu mobile">
        <a href="/">Accueil</a>
        {liens.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="menu-mobile-bas">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener">Instagram</a>
      </div>
    </div>

    <main>
      <slot />
    </main>

    {!sansFooter && (
      <footer class="pied">
        <div class="conteneur pied-grille">
          <div>
            <p class="titre-m">Un projet&nbsp;?</p>
            <a href="/contact/" class="pied-cta">Parlons-en →</a>
          </div>
          <div class="pied-liens">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <a href={whatsapp} target="_blank" rel="noopener">WhatsApp</a>
            <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener">Instagram</a>
          </div>
        </div>
        <div class="conteneur pied-bas">
          <span>© {new Date().getFullYear()} {site.nom}</span>
          <span>Toutes les photos sont protégées par le droit d'auteur.</span>
        </div>
      </footer>
    )}

    <script>
      // Menu mobile
      const burger = document.querySelector<HTMLButtonElement>('.burger')!;
      const menu = document.getElementById('menu-mobile')!;
      burger.addEventListener('click', () => {
        const ouvert = burger.getAttribute('aria-expanded') === 'true';
        burger.setAttribute('aria-expanded', String(!ouvert));
        burger.setAttribute('aria-label', ouvert ? 'Ouvrir le menu' : 'Fermer le menu');
        document.body.classList.toggle('menu-ouvert', !ouvert);
        if (ouvert) { menu.classList.remove('ouvert'); setTimeout(() => (menu.hidden = true), 400); }
        else { menu.hidden = false; requestAnimationFrame(() => menu.classList.add('ouvert')); }
      });

      // En-tête : fond au scroll
      const entete = document.querySelector('.entete')!;
      const majEntete = () => entete.classList.toggle('scrolle', window.scrollY > 40);
      majEntete(); window.addEventListener('scroll', majEntete, { passive: true });

      // Apparition au scroll
      const io = new IntersectionObserver((entrees) => {
        entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .entete {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    height: var(--header);
    display: flex; align-items: center; justify-content: space-between;
    padding-inline: var(--marge);
    transition: background 0.4s, backdrop-filter 0.4s;
  }
  .entete.scrolle, :global(body.menu-ouvert) .entete { background: rgba(251, 250, 248, 0.9); backdrop-filter: blur(12px); box-shadow: 0 1px 0 var(--ligne); }
  :global(body.menu-ouvert) .entete { background: transparent; backdrop-filter: none; }
  .logo { display: flex; flex-direction: column; line-height: 1.05; }
  .logo-nom { font-stretch: 125%; font-weight: 800; text-transform: uppercase; font-size: 1rem; letter-spacing: 0.02em; }
  .logo-metier { font-size: 0.68rem; font-weight: 400; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gris); }
  .nav { display: flex; gap: 2.5rem; }
  .nav a {
    position: relative; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase;
  }
  .nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: right; transition: transform 0.5s var(--ease);
  }
  .nav a:hover::after, .nav a.actif::after { transform: scaleX(1); transform-origin: left; }
  .burger { display: none; width: 44px; height: 44px; position: relative; z-index: 60; }
  .burger span { position: absolute; left: 10px; right: 10px; height: 1.5px; background: var(--texte); transition: transform 0.4s var(--ease); }
  .burger span:first-child { top: 18px; } .burger span:last-child { top: 25px; }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .menu-mobile {
    position: fixed; inset: 0; z-index: 40; background: var(--fond);
    display: flex; flex-direction: column; justify-content: space-between;
    padding: calc(var(--header) + 40px) var(--marge) 40px;
    opacity: 0; transition: opacity 0.4s var(--ease);
  }
  .menu-mobile[hidden] { display: none; }
  .menu-mobile.ouvert { opacity: 1; }
  .menu-mobile nav { display: flex; flex-direction: column; gap: 0.4rem; }
  .menu-mobile nav a {
    font-stretch: 125%; font-weight: 800; text-transform: uppercase; font-size: clamp(2.2rem, 11vw, 3.5rem); line-height: 1.1;
    transform: translateY(20px); opacity: 0; transition: transform 0.6s var(--ease), opacity 0.6s var(--ease);
  }
  .menu-mobile.ouvert nav a { transform: none; opacity: 1; }
  .menu-mobile.ouvert nav a:nth-child(2) { transition-delay: 0.05s; }
  .menu-mobile.ouvert nav a:nth-child(3) { transition-delay: 0.1s; }
  .menu-mobile.ouvert nav a:nth-child(4) { transition-delay: 0.15s; }
  .menu-mobile-bas { display: flex; flex-direction: column; gap: 0.5rem; color: var(--gris); font-size: 0.95rem; }
  :global(body.menu-ouvert) { overflow: hidden; }

  .pied { border-top: 1px solid var(--ligne); margin-top: clamp(80px, 12vw, 160px); padding-top: clamp(48px, 7vw, 96px); }
  .pied-grille { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap; }
  .pied-cta { display: inline-block; margin-top: 0.6rem; font-size: clamp(1.6rem, 4vw, 3rem); font-weight: 200; font-stretch: 100%; transition: color 0.3s, transform 0.4s var(--ease); }
  .pied-cta:hover { color: var(--accent); transform: translateX(8px); }
  .pied-liens { display: flex; flex-direction: column; gap: 0.35rem; text-align: right; color: var(--texte-2); }
  .pied-liens a:hover { color: var(--texte); }
  .pied-bas { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 48px 32px; font-size: 0.78rem; color: var(--gris); }

  @media (max-width: 760px) {
    :global(:root) { --header: 64px; }
    .nav { display: none; }
    .burger { display: block; }
    .pied-liens { text-align: left; }
  }
</style>
